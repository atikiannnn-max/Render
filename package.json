{
  "name": "render-3d-ceramic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight photorealistic WebGL renderer for a 3D-printed ceramic cup",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "blender:stone": "\"/Applications/Blender.app/Contents/MacOS/Blender\" -b -y --python blender/build_cup.py -- --clay stone",
    "blender:asphalt": "\"/Applications/Blender.app/Contents/MacOS/Blender\" -b -y --python blender/build_cup.py -- --clay asphalt"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "vite": "^7.3.0"
  }
}
